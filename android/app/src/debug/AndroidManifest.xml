<?xml version="1.0" encoding="utf-8"?>
<!-- The debug build's own document provider, for the import's checks on the
     emulator (specs/android.md L12d): src/debug is built into debug builds
     only, so a release has none. Not exported: only the app itself opens it,
     through the pick extra (SoaActivity). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <provider
            android:name=".TestFilesProvider"
            android:authorities="${applicationId}.testfiles"
            android:exported="false" />
    </application>
</manifest>
